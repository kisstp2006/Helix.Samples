/* The light theme: the root's variables (the C# script switches to it from Dark.hss). */
:root {
    --page: #eef1f6;
    --panel: #ffffff;
    --raised: #e3e8f0;
    --line: #c9d1de;
    --track: #d5dbe5;
    --text: #1b2230;
    --muted: #5b6678;
    --accent: #2f6fd6;
    --on-accent: #ffffff;
}
