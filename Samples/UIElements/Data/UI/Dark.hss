/* The dark theme: the root's variables (the C# script adds this sheet to the root, or Light.hss). */
:root {
    --page: #14171d;
    --panel: #1e222b;
    --raised: #2a303c;
    --line: #3a4252;
    --track: #0f1116;
    --text: #e6e9ef;
    --muted: #8892a6;
    --accent: #4f9dff;
    --on-accent: #0b1220;
}
